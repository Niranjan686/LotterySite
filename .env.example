# ==================================================================
# ROYAL PALMS — FLAT ALLOCATION & LIVE LUCKY DRAW LOTTERY PORTAL
# Copy this file to .env and customize for your environment
# ==================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Primary MongoDB Configuration
# Leave commented out in local dev to auto-connect to mongodb://127.0.0.1:27017/royal_palms_lottery
# (or auto-launch persistent local MongoDB if no Windows service is running)
# MONGODB_URI=mongodb://127.0.0.1:27017/royal_palms_lottery

# Security & Admin Authentication
JWT_SECRET=change-this-strong-royal-palms-jwt-secret-in-production
JWT_EXPIRES_IN=12h
LOTTERY_HMAC_SECRET=change-this-strong-ticket-hmac-verification-secret

# Initial Bootstrap Super Admin (used only when AdminUsers collection is empty)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=committee.admin@royalpalms.org
ADMIN_DEFAULT_PASSWORD=RoyalPalms@2026
